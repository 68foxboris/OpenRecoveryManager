#, c-format
msgid "The backup is saved as %s/images/%s."
msgstr "Резервная копия сохранена как %s/images/%s."

#: src/backup.c
msgid "The backup was cancelled."
msgstr "Резервное копирование отменено."

#: src/backup.c
msgid "The backup failed."
msgstr "Резервное копирование не удалось."

