msgstr ""
"Enigma2 успешно переустановлена, сторонние файлы перемещены в %s. Перезапустите "
"Enigma2 через меню."

#: src/repair.c
msgid "Enigma2 is installed again. Restart Enigma2 in the menu."
msgstr "Enigma2 успешно переустановлена. Перезапустите Enigma2 через меню."

#: src/repair.c
msgid "Enigma2 could not be installed again."
msgstr "Не удалось переустановить Enigma2."

#: src/update.c
msgid "feed status unknown"
msgstr "статус фида неизвестен"

#: src/update.c
msgid "feed disabled"
msgstr "фид отключен"

