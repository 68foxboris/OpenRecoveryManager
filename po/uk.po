msgid "STARTED FROM THE CONSOLE"
msgstr "ЗАПУЩЕНО З КОНСОЛІ"

msgid "Enigma2 is stopped"
msgstr "Enigma2 зупинено"

msgid "Recovery Manager runs from a console session. After it ends, Enigma2 can be started again with init 3."
msgstr "Recovery Manager запущено з консольної сесії. Після завершення Enigma2 можна знову запустити командою init 3."

msgid "OPENED FROM THE MENU"
msgstr "ВІДКРИТО З МЕНЮ"

msgid "Enigma2 is paused"
msgstr "Enigma2 призупинено"

msgid "Recovery Manager was opened from the menu. After it ends, Enigma2 starts again on its own."
msgstr "Recovery Manager відкрито з меню. Після завершення Enigma2 автоматично перезапуститься."

msgid "ENIGMA2 STOPPED RESPONDING WHILE STARTING"
msgstr "ENIGMA2 ПЕРЕСТАЛА ВІДПОВІДАТИ ПІД ЧАС ЗАПУСКУ"

msgid "ENIGMA2 STOPPED WITH A PYTHON ERROR SHORTLY AFTER THE START"
msgstr "ENIGMA2 ЗУПИНИЛАСЯ З ПОМИЛКОЮ PYTHON НЕВДОВЗІ ПІСЛЯ ЗАПУСКУ"

msgid "ENIGMA2 STOPPED WITH A PYTHON ERROR WHILE STARTING"
msgstr "ENIGMA2 ЗУПИНИЛАСЯ З ПОМИЛКОЮ PYTHON ПІД ЧАС ЗАПУСКУ"

msgid "ENIGMA2 CRASHED SHORTLY AFTER THE START"
msgstr "ENIGMA2 ЗАЗНАЛА ЗБОЮ НЕВДОВЗІ ПІСЛЯ ЗАПУСКУ"

msgid "ENIGMA2 CRASHED WHILE STARTING"
msgstr "ENIGMA2 ЗАЗНАЛА ЗБОЮ ПІД ЧАС ЗАПУСКУ"

