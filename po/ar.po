msgid "About"
msgstr "حول"

#: src/main.c:419
msgid "Reboot"
msgstr "إعادة التشغيل"

#: src/main.c:419
msgid "Shutdown"
msgstr "إيقاف التشغيل"

#: src/main.c:609
#, c-format
msgid "%s %s (%s)\n%s %s, build %s (%s)\nEnigma2 revision %s"
msgstr "%s %s (%s)\n%s %s، الإصدار %s (%s)\nمراجعة Enigma2 %s"

#: src/remote.c:86
msgid "End the Remote Support session? The supporter can then no longer work on the receiver."
msgstr "إنهاء جلسة Remote Support؟ لن يتمكن فني الدعم عندها من العمل على الجهاز."

#: src/remote.c:99 src/flash.c:1233 src/backup.c:573
msgid "Cancel"
msgstr "إلغاء"

#: src/remote.c:100
msgid "Starting the Remote Support session."
msgstr "جارٍ بدء جلسة Remote Support."

#: src/remote.c:101
msgid "Connecting to the support server, this takes a few seconds."
msgstr "جارٍ الاتصال بخادم الدعم، يستغرق ذلك بضع ثوانٍ."

#: src/remote.c:107
msgid "Scan the QR code with your phone and send the link to your supporter from there."
msgstr "امسح رمز QR بهاتفك وأرسل الرابط من هناك إلى فني الدعم."

#: src/remote.c:108
msgid "Send the link below to your supporter or let them scan the QR code."
msgstr "أرسل الرابط أدناه إلى فني الدعم أو دعه يمسح رمز QR."

#: src/remote.c:109
msgid "Approved users can open terminals. Everybody who joins later has to be approved as well."
msgstr "يمكن للمستخدمين الموافق عليهم فتح الطرفيات. كل من ينضم لاحقًا يحتاج إلى موافقة أيضًا."

#: src/remote.c:110
msgid "When somebody joins the session, you have to approve the access with the remote control."
msgstr "عندما ينضم أحد إلى الجلسة، عليك الموافقة على الوصول بجهاز التحكم عن بُعد."

#: src/remote.c:111
msgid "The session keeps running in the menu and ends when Enigma2 starts."
msgstr "تستمر الجلسة في القائمة وتنتهي عند تشغيل Enigma2."

#: src/remote.c:112
msgid "The session keeps running in the menu and after Enigma2 starts."
msgstr "تستمر الجلسة في القائمة وبعد تشغيل Enigma2."

#: src/remote.c:113
msgid "Ending the session..."
msgstr "جارٍ إنهاء الجلسة..."

#: src/remote.c:114
msgid "End session"
msgstr "إنهاء الجلسة"

#: src/remote.c:116
msgid "Do not post the link or a screenshot of it in public forums: everybody who has it can try to join and sees the terminals until you deny the access."
msgstr "لا تنشر الرابط أو لقطة شاشة له في المنتديات العامة: كل من لديه الرابط يمكنه محاولة الانضمام ويرى الطرفيات حتى ترفض الوصول."

#: src/remote.c:119
msgid "Scan with your phone to send the link to your supporter"
msgstr "امسح بهاتفك لإرسال الرابط إلى فني الدعم"

#: src/remote.c:120
msgid "Scan to open the support session"
msgstr "امسح لفتح جلسة الدعم"

#: src/remote.c:196
#, c-format
msgid "Users: %s\nTerminals: %d"
msgstr "المستخدمون: %s\nالطرفيات: %d"

#: src/remote.c:256
msgid "Not installed, it goes into RAM until the next restart, the flash stays as it is. Please wait..."
msgstr "غير مثبّت، سيُحمَّل في RAM حتى إعادة التشغيل التالية، وتبقى الذاكرة الداخلية كما هي. يرجى الانتظار..."

#: src/remote.c:258
msgid "Installing into RAM"
msgstr "التثبيت في RAM"

#: src/remote.c:272
msgid "Remote Support could not be installed."
msgstr "تعذّر تثبيت Remote Support."

#: src/remote.c:324
msgid "Remote Support cannot be started."
msgstr "لا يمكن بدء Remote Support."

#: src/remote.c:369
msgid "Start Remote Support? A supporter can then work on the receiver from the internet."
msgstr "بدء Remote Support؟ سيتمكن فني الدعم عندها من العمل على الجهاز عبر الإنترنت."

#: src/remote.c:397
msgid "The Remote Support session ended."
msgstr "انتهت جلسة Remote Support."

#: src/reset.c:90 src/reset.c:105 src/plugins.c:330
#, c-format
msgid "%s cannot be moved: %s"
msgstr "لا يمكن نقل %s: %s"

#: src/reset.c:100
#, c-format
msgid "%s cannot be created: %s"
msgstr "لا يمكن إنشاء %s: %s"

#: src/reset.c:130
msgid "Only the settings (channel lists and timers stay)"
msgstr "الإعدادات فقط (تبقى قوائم القنوات والمؤقتات)"

#: src/reset.c:131
msgid "Everything, including channel lists and timers"
msgstr "كل شيء، بما في ذلك قوائم القنوات والمؤقتات"

#: src/reset.c:132
#, c-format
msgid "What should be reset? Enigma2 then starts with the wizard, which offers to restore a backup. The files are kept in a folder next to %s, the network settings stay."
msgstr "ما الذي تريد إعادة ضبطه؟ سيبدأ Enigma2 بعدها بمعالج الإعداد الذي يعرض استعادة نسخة احتياطية. تُحفظ الملفات في مجلد بجانب %s، وتبقى إعدادات الشبكة."

#: src/reset.c:134
msgid "Reset"
msgstr "إعادة ضبط"

#: src/reset.c:141
msgid "Reset everything now? Enigma2 then starts like new, without channel lists and timers. Your old files are kept."
msgstr "إعادة ضبط كل شيء الآن؟ سيبدأ Enigma2 كأنه جديد، بدون قوائم القنوات والمؤقتات. ستُحفظ ملفاتك القديمة."

#: src/reset.c:142
msgid "Reset the settings now? Your channel lists and timers stay, all other settings start from the beginning. Your old settings are kept."
msgstr "إعادة ضبط الإعدادات الآن؟ تبقى قوائم القنوات والمؤقتات، وتبدأ كل الإعدادات الأخرى من جديد. ستُحفظ إعداداتك القديمة."

#: src/reset.c:151
#, c-format
msgid "The files of Enigma2 were reset, the old ones are kept in %s."
msgstr "تمت إعادة ضبط ملفات Enigma2، والملفات القديمة محفوظة في %s."

#: src/reset.c:152
#, c-format
msgid "The settings were reset, the old file is kept in %s."
msgstr "تمت إعادة ضبط الإعدادات، والملف القديم محفوظ في %s."

#: src/reset.c:154
msgid "Restart Enigma2 in the menu to start with the wizard."
msgstr "أعد تشغيل Enigma2 من القائمة للبدء بمعالج الإعداد."

