msgid "Back up image"
msgstr "نسخ الصورة احتياطيًا"

#: src/main.c:337 src/flash.c:25
msgid "Flash online/local"
msgstr "تثبيت صورة عبر الإنترنت/محليًا"

#: src/main.c:338 src/slots.c:18
msgid "Boot another slot"
msgstr "الإقلاع من فتحة أخرى"

#: src/main.c:353
msgid "Starts Enigma2 again. If a plugin keeps it from starting, disable the plugin first."
msgstr "يعيد تشغيل Enigma2. إذا كانت إضافة تمنع التشغيل، فعطّلها أولاً."

#: src/main.c:354
msgid "Shows the newest crash log of Enigma2. BLUE shows the steps of the last start."
msgstr "يعرض أحدث سجل أعطال لـ Enigma2. يعرض BLUE خطوات آخر تشغيل."

#: src/main.c:356
msgid "Moves a plugin to Plugins.disabled, so Enigma2 neither loads nor removes it, and back again. The plugin of the last start step is chosen at first."
msgstr "ينقل الإضافة إلى Plugins.disabled، فلا يحمّلها Enigma2 ولا يحذفها، ويعيدها مرة أخرى. تكون إضافة آخر خطوة تشغيل محددة مسبقًا."

#: src/main.c:358
msgid "Installs the latest updates for your receiver. You see the list and confirm before anything is installed."
msgstr "يثبّت أحدث التحديثات لجهازك. سترى القائمة وتؤكد قبل تثبيت أي شيء."

#: src/main.c:360
msgid "Resets Enigma2 to the state of a new installation. Your old settings are moved aside, so nothing is deleted for good."
msgstr "يعيد Enigma2 إلى حالة التثبيت الجديد. يتم نقل إعداداتك القديمة جانبًا، فلا يُحذف شيء نهائيًا."

#: src/main.c:362
msgid "Saves the running image as a zip file on a USB stick or hard disk, so it can be flashed again later."
msgstr "يحفظ الصورة الحالية كملف zip على ذاكرة USB أو قرص صلب، ليمكن تثبيتها مجددًا لاحقًا."

#: src/main.c:363
msgid "Flashes an image into the running slot, from the feed of the running distribution or from the media. A check with ofgwrite tests the image before anything is written."
msgstr "يثبّت صورة نظام في الفتحة الحالية، من مصدر التوزيعة الحالية أو من وسائط التخزين. يختبر فحص بواسطة ofgwrite الصورة قبل كتابة أي شيء."

#: src/main.c:365
msgid "Restarts the receiver with the image of another slot."
msgstr "يعيد تشغيل الجهاز بصورة النظام من فتحة أخرى."

#: src/main.c:379
#, c-format
msgid "Newest crash log: %s"
msgstr "أحدث سجل أعطال: %s"

#. TRANSLATORS: %s is the distribution, e.g. OpenATV.
#: src/main.c:387
#, c-format
msgid "Sends the crash report to the %s ticket system, so the developers can find the error. You see everything before it is sent."
msgstr "يرسل تقرير العطل إلى نظام التذاكر لدى %s، حتى يتمكن المطورون من إيجاد الخطأ. سترى كل شيء قبل إرساله."

#: src/main.c:412
#, c-format
msgid "Restart in %d s, any key cancels"
msgstr "إعادة التشغيل خلال %d ث، أي زر يلغيها"

