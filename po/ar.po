msgstr "%s (%s على %s)، الصورة الحالية"

#: src/flash.c:1489
#, c-format
msgid "%s (%s), the running image"
msgstr "%s (%s)، الصورة الحالية"

#: src/flash.c:1513
msgid "Flashing finished, restart the receiver in the menu."
msgstr "اكتمل التثبيت، أعد تشغيل الجهاز من القائمة."

#: src/flash.c:1515
#, c-format
msgid "Flashing failed, see %s."
msgstr "فشل التثبيت، راجع %s."

#: src/flash.c:1519 src/flash.c:1642
msgid "ofgwrite wrote nothing."
msgstr "لم يُخرج ofgwrite أي شيء."

#: src/flash.c:1570
msgid "Flashing"
msgstr "التثبيت"

#: src/flash.c:1588
msgid "flashed too, kernel A of all slots"
msgstr "يُثبَّت أيضًا، النواة A لكل الفتحات"

#: src/flash.c:1590 src/flash.c:1592 src/flash.c:1594
#, c-format
msgid "flashed too (%s)"
msgstr "يُثبَّت أيضًا (%s)"

#: src/flash.c:1596
msgid "flashed too"
msgstr "يُثبَّت أيضًا"

#: src/flash.c:1599
msgid "stays as it is"
msgstr "يبقى كما هو"

#: src/flash.c:1608 src/flash.c:1839
msgid "Image"
msgstr "الصورة"

#: src/flash.c:1611 src/flash.c:1614
msgid "Location"
msgstr "الموقع"

#: src/flash.c:1615
msgid "Slot"
msgstr "الفتحة"

#: src/flash.c:1617
msgid "Kernel"
msgstr "النواة"

#: src/flash.c:1618
msgid "Command"
msgstr "الأمر"

#: src/flash.c:1635
msgid "The check was successful"
msgstr "نجح الفحص"

#: src/flash.c:1635
msgid "The check failed"
msgstr "فشل الفحص"

#: src/flash.c:1637
msgid "Flash now"
msgstr "ثبّت الآن"

#: src/flash.c:1645
msgid "Flash the image now? The running image is replaced and the receiver restarts. Do not switch it off while it flashes."
msgstr "تثبيت الصورة الآن؟ ستُستبدل الصورة الحالية ويُعاد تشغيل الجهاز. لا تُطفئه أثناء التثبيت."

#: src/flash.c:1665
msgid "Clean flash: all settings are lost, after the restart the most recent backup can be restored."
msgstr "تثبيت نظيف: تُفقد كل الإعدادات، ويمكن بعد إعادة التشغيل استعادة أحدث نسخة احتياطية."

#: src/flash.c:1666
msgid "The check only tests the image and writes nothing. After a successful check, OK starts flashing."
msgstr "الفحص يختبر الصورة فقط ولا يكتب شيئًا. بعد نجاح الفحص، يبدأ OK التثبيت."

#: src/flash.c:1705
#, c-format
msgid "There is not enough free space on %s, it needs %lld MB."
msgstr "لا توجد مساحة فارغة كافية على %s، المطلوب %lld MB."

#: src/flash.c:1716
msgid "The image could not be downloaded."
msgstr "تعذّر تنزيل الصورة."

